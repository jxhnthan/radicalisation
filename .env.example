# LLM endpoint (OpenAI-compatible). Copy to .env and fill in.
#
# Local (default):
#   Ollama:  LLM_BASE_URL=http://localhost:11434/v1   (key can be "ollama")
#
# Cloud alternatives:
#   OpenAI:       https://api.openai.com/v1
#   NVIDIA NIM:   https://integrate.api.nvidia.com/v1  (free credits at build.nvidia.com)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
